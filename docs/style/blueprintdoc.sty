%% blueprintdoc.sty — article-class companion to the Blueprint beamer theme (LuaLaTeX).
%% Same palette, fonts and components, for the field guide, cheat sheet, role cards and worksheet.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{blueprintdoc}[2026/09/08 v1.0 Blueprint document style]
\newif\ifbpd@grid \bpd@gridfalse
\DeclareOption{grid}{\bpd@gridtrue}
\ProcessOptions\relax

\RequirePackage[a4paper,margin=18mm,top=20mm,bottom=20mm]{geometry}
\RequirePackage{fontspec}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{calc,positioning,shapes.misc,patterns,arrows.meta,fit,backgrounds}
\RequirePackage[most]{tcolorbox}
\RequirePackage{listings}
\RequirePackage{fontawesome5}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{enumitem}
\RequirePackage{ragged2e}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{hyperref}
\RequirePackage{etoolbox}
\RequirePackage{parskip}
\RequirePackage{multicol}

\definecolor{bpInk}{HTML}{14213D}
\definecolor{bpRed}{HTML}{B23A2E}
\definecolor{bpGreen}{HTML}{2F6646}
\definecolor{bpAmber}{HTML}{8A5A00}
\definecolor{bpGraphite}{HTML}{5A5A5A}
\definecolor{bpPaper}{HTML}{FFFFFF}
\colorlet{bpRule}{bpInk!35!white}
\colorlet{bpGrid}{bpInk!8!white}
\colorlet{bpPaperDark}{bpInk!6!white}
\colorlet{bpRedPale}{bpRed!10!white}
\colorlet{bpGreenPale}{bpGreen!10!white}

\setmainfont{SourceSansPro}[Extension=.otf, UprightFont=*-Regular, ItalicFont=*-RegularIt, BoldFont=*-Semibold, BoldItalicFont=*-SemiboldIt]
\setsansfont{SourceSansPro}[Extension=.otf, UprightFont=*-Regular, ItalicFont=*-RegularIt, BoldFont=*-Semibold, BoldItalicFont=*-SemiboldIt]
\setmonofont{JetBrainsMono}[Extension=.otf, Scale=MatchLowercase, UprightFont=*-Regular, BoldFont=*-Bold, ItalicFont=*-Italic, BoldItalicFont=*-BoldItalic]
\newfontfamily\bpdisplay{PlayfairDisplay}[Extension=.otf, UprightFont=*-Regular, BoldFont=*-Bold, ItalicFont=*-Italic, BoldItalicFont=*-BoldItalic]
\newfontfamily\bpmono{JetBrainsMono}[Extension=.otf, Scale=MatchLowercase, UprightFont=*-Regular, BoldFont=*-Bold]
\color{bpInk}

\hypersetup{colorlinks=true, linkcolor=bpInk, urlcolor=bpRed, citecolor=bpInk, pdfborder={0 0 0}}
\urlstyle{tt}

% headings
\titleformat{\section}{\bpdisplay\bfseries\LARGE\color{bpInk}}{}{0pt}{}[{\color{bpRule}\titlerule[0.5pt]}]
\titleformat{\subsection}{\bpdisplay\bfseries\large\color{bpInk}}{}{0pt}{}
\titleformat{\subsubsection}{\bfseries\normalsize\color{bpInk}}{}{0pt}{}
\titlespacing*{\section}{0pt}{14pt}{6pt}
\titlespacing*{\subsection}{0pt}{10pt}{3pt}
\titlespacing*{\subsubsection}{0pt}{8pt}{2pt}

% header / footer as a title block
\newcommand{\bpdoccode}{}
\newcommand{\setdoccode}[1]{\renewcommand{\bpdoccode}{#1}}
\newcommand{\bpdoctitle}{}
\newcommand{\setdoctitle}[1]{\renewcommand{\bpdoctitle}{#1}}
\pagestyle{fancy}\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}\renewcommand{\headrule}{{\color{bpRule}\hrule width\headwidth height 0.4pt}}
\renewcommand{\footrulewidth}{0pt}
\fancyhead[L]{\bpmono\scriptsize\color{bpGraphite}\bpdoctitle}
\fancyhead[R]{\bpmono\scriptsize\color{bpGraphite}\bpdoccode\quad\textbar\quad SHEET \thepage}
\fancyfoot[L]{\bpmono\tiny\color{bpGraphite}Neural network verification — hands-on materials · ACM Europe Seasonal School on Responsible AI, Aston University, Sept 2026 · CC BY 4.0}

% document title block
\newcommand{\bptitleblock}[3]{% {title}{subtitle}{meta line}
  \noindent{\bpmono\small\color{bpGraphite}#3\par}\vspace{2mm}
  {\bpdisplay\bfseries\Huge\color{bpInk}#1\par}\vspace{1.5mm}
  {\large\color{bpGraphite}#2\par}\vspace{2mm}{\color{bpRule}\hrule height 0.6pt}\vspace{5mm}}

% components (shared with the beamer theme)
\newcommand{\stamp}[2][bpRed]{\tikz[baseline=(s.base)]{\node[draw=#1,double,double distance=1pt,line width=0.7pt,rounded corners=1pt,inner sep=3pt,rotate=-6,text=#1,font=\bpmono\bfseries\small] (s) {#2};}}
\newcommand{\verified}{\stamp[bpGreen]{VERIFIED}}
\newcommand{\counterexample}{\stamp[bpRed]{COUNTEREXAMPLE}}
\newcommand{\unknown}{\stamp[bpAmber]{UNKNOWN}}
\newcommand{\okmark}{{\color{bpGreen}\faCheck}}
\newcommand{\badmark}{{\color{bpRed}\faTimes}}
\newcommand{\qmark}{{\color{bpAmber}\textbf{?}}}
\newcommand{\quiet}[1]{{\color{bpGraphite}#1}}
\newcommand{\src}[1]{{\bpmono\scriptsize\color{bpGraphite}#1}}
\newcommand{\term}[1]{\textbf{#1}}

\newtcolorbox{notebox}[1][]{enhanced,colback=bpPaperDark,colframe=bpRule,boxrule=0.5pt,arc=0pt,left=2.5mm,right=2.5mm,top=1.5mm,bottom=1.5mm,#1}
\newtcolorbox{redbox}[1][]{enhanced,colback=bpRedPale,colframe=bpRed,boxrule=0.6pt,arc=0pt,left=2.5mm,right=2.5mm,top=1.5mm,bottom=1.5mm,#1}
\newtcolorbox{greenbox}[1][]{enhanced,colback=bpGreenPale,colframe=bpGreen,boxrule=0.6pt,arc=0pt,left=2.5mm,right=2.5mm,top=1.5mm,bottom=1.5mm,#1}
\newtcblisting{expected}[1][EXPECTED OUTPUT]{enhanced,listing only,colback=bpInk,colframe=bpInk,coltext=white,boxrule=0pt,arc=1.5pt,left=2.5mm,right=2.5mm,top=1.5mm,bottom=1.5mm,
  listing options={language={},basicstyle=\bpmono\footnotesize\color{white},keywordstyle=,commentstyle=\color{white},escapeinside={(*@}{@*)},breaklines=true},
  overlay={\node[anchor=north east,inner sep=1.2mm,font=\bpmono\tiny,text=white!60!bpInk] at (frame.north east) {#1};}}
\newtcolorbox{incidentcard}[1][INCIDENT REPORT]{enhanced,colback=bpPaperDark,colframe=bpInk,boxrule=0.5pt,arc=0pt,left=2.5mm,right=2.5mm,top=2mm,bottom=2mm,fontupper=\small\RaggedRight,
  overlay={\node[anchor=north east,inner sep=1.2mm,font=\bpmono\tiny,text=bpGraphite] at (frame.north east) {#1};}}
\newcommand{\incident}[4]{\begin{incidentcard}{\bpmono\scriptsize\color{bpGraphite}\MakeUppercase{#1}\quad\textbar\quad #2\par}\vspace{1mm}{\bpdisplay\bfseries\normalsize\color{bpInk}\RaggedRight #3\par}\vspace{1mm}{\small\RaggedRight #4\par}\end{incidentcard}}

\lstdefinelanguage{vcl}{alsoletter={@},sensitive=true,
  morekeywords={forall,exists,foreach,let,in,if,then,else,and,or,not,type,record,where},
  morekeywords=[2]{Tensor,Real,Rat,Nat,Int,Index,Bool,Vector,List},
  morekeywords=[3]{@network,@property,@parameter,@dataset,@tensor},
  morecomment=[l]{--},morestring=[b]"}
\lstset{basicstyle=\bpmono\footnotesize\color{bpInk},keywordstyle=\color{bpRed}\bfseries,keywordstyle=[2]\color{bpGreen},keywordstyle=[3]\color{bpInk}\bfseries,
  commentstyle=\color{bpGraphite}\itshape,stringstyle=\color{bpGraphite},columns=fullflexible,keepspaces=true,showstringspaces=false,breaklines=true,tabsize=2,
  literate={ε}{{$\varepsilon$}}1 {≤}{{$\le$}}1 {≥}{{$\ge$}}1 {→}{{$\to$}}1 {⇒}{{$\Rightarrow$}}1 {∀}{{$\forall$}}1 {∃}{{$\exists$}}1}
\newtcblisting{vclbox}[1][]{enhanced,listing only,colback=bpPaperDark,colframe=bpInk,boxrule=0.5pt,arc=0pt,left=2mm,right=2mm,top=1.5mm,bottom=1.5mm,
  listing options={language=vcl,basicstyle=\bpmono\footnotesize\color{bpInk}},
  overlay={\node[anchor=north east,inner sep=1.2mm,font=\bpmono\tiny,text=bpGraphite] at (frame.north east) {#1};}}
\newtcblisting{shellbox}[1][]{enhanced,listing only,colback=bpInk,colframe=bpInk,coltext=white,boxrule=0pt,arc=1.5pt,left=2.5mm,right=2.5mm,top=1.5mm,bottom=1.5mm,
  listing options={language={},basicstyle=\bpmono\footnotesize\color{white},keywordstyle=,commentstyle=\color{white},escapeinside={(*@}{@*)}},
  overlay={\node[anchor=north east,inner sep=1.2mm,font=\bpmono\tiny,text=white!60!bpInk] at (frame.north east) {#1};}}
\newcommand{\tprompt}{{\color{white!60!bpInk}\$ }}
\newcommand{\tok}{{\color{bpGreen!40!white}\faCheck}}
\newcommand{\tbad}{{\color{bpRed!55!white}\faTimes}}

\setlist{itemsep=1pt,topsep=2pt,leftmargin=1.4em}
\setlist[itemize]{label=\raisebox{0.2ex}{\tikz\draw[bpInk,line width=0.5pt] (0,0) rectangle (0.7ex,0.7ex);}}
\tikzset{bp/.style={line width=0.6pt,bpInk},bpthin/.style={line width=0.4pt,bpRule},bpred/.style={line width=0.8pt,bpRed},bpgreen/.style={line width=0.8pt,bpGreen},
  bplabel/.style={font=\bpmono\scriptsize,text=bpGraphite},bpnode/.style={draw=bpInk,line width=0.6pt,fill=bpPaperDark,rounded corners=1pt,inner sep=3pt,font=\small,align=center}}
\endinput
